{
  "schema_version": 4,
  "metadata": {
    "name": "Tempo Step Bass",
    "author": "Sonalloy",
    "description": "A tempo-synchronous step bass with cutoff, beat phase, and bar phase movement"
  },
  "performance": {
    "mode": "polyphonic",
    "polyphony": 4,
    "voice_stealing": "quietest_releasing_then_oldest"
  },
  "layers": [
    {
      "id": "bass",
      "enabled": true,
      "trigger": {
        "event": "note_on",
        "key_min": 0,
        "key_max": 127,
        "velocity_min": 1,
        "velocity_max": 127
      },
      "gain_db": -9.0,
      "pan": 0.0,
      "tuning_cents": 0.0,
      "envelope": {
        "attack_seconds": 0.005,
        "decay_seconds": 0.15,
        "sustain_level": 0.65,
        "release_seconds": 0.25
      },
      "generator": {
        "oscillator": {
          "waveform": {
            "type": "square"
          },
          "phase_reset": true,
          "phase": 0.0
        }
      }
    }
  ],
  "voice_processors": [
    {
      "type": "filter",
      "id": "tone",
      "cutoff_hz": 900.0,
      "resonance": 0.2
    }
  ],
  "global_processors": [],
  "modulation": {
    "sources": [
      {
        "type": "step",
        "id": "bass_step",
        "values": [
          -1.0,
          0.5,
          -0.25,
          1.0
        ],
        "rate": {
          "value": 4.0,
          "unit": "per_beat"
        }
      }
    ],
    "routes": [
      {
        "source": "bass_step",
        "target": "voice.processor.tone.cutoff",
        "depth": {
          "value": 2.5,
          "unit": "octaves"
        },
        "curve": "linear"
      },
      {
        "source": "bass_step",
        "target": "layer.bass.gain",
        "depth": {
          "value": 4.0,
          "unit": "decibels"
        },
        "curve": "linear"
      },
      {
        "source": "transport_beat_phase",
        "target": "voice.processor.tone.cutoff",
        "depth": {
          "value": 0.5,
          "unit": "octaves"
        },
        "curve": "linear"
      },
      {
        "source": "transport_bar_phase",
        "target": "voice.processor.tone.cutoff",
        "depth": {
          "value": 0.35,
          "unit": "octaves"
        },
        "curve": "linear"
      }
    ]
  },
  "macros": [],
  "vectors": []
}

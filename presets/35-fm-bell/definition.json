      },
      "gain_db": -25,
      "pan": 0,
      "tuning_cents": 0,
      "envelope": {
        "attack_seconds": 0.001,
        "decay_seconds": 0,
        "sustain_level": 1,
        "release_seconds": 3
      },
      "generator": {
        "operator_modulation": {
          "mode": "phase",
          "algorithm": "two_stacks",
          "operators": [
            {
              "ratio": 1,
              "detune_cents": 0,
              "level": 0.84,

                "attack_seconds": 0.001,
                "decay_seconds": 1.7,
                "sustain_level": 0.09,
                "release_seconds": 1
              }
            },
            {
              "ratio": 2.003,
              "detune_cents": 0,
              "level": 0.23,
              "modulation_amount": 0,
              "feedback": 0,
              "phase": 0.19,
              "envelope": {
                "attack_seconds": 0.001,
                "decay_seconds": 2.3,
                "sustain_level": 0,
                "release_seconds": 1.5
              }
            },
            {
              "ratio": 3.507,
              "detune_cents": 0,
              "level": 0,
              "modulation_amount": 1.15,
              "feedback": 0,
              "phase": 0,
              "envelope": {
                "attack_seconds": 0.001,
                "decay_seconds": 0.62,
                "sustain_level": 0,
                "release_seconds": 0.5

{
  "schema_version": 5,
  "metadata": {
    "name": "Sub Drop",
    "author": "glm-5.3-flash",
    "description": "中低域に認識できる音程から、数秒かけて非常に低い帯域へ滑らかに沈んでいく低域中心の演出音。ノイズ成分をほとんど持たず、低音そのものの移動感が中心。下降しながら減衰し、一回の演出として完結する。"
  },
  "performance": {
    "mode": "polyphonic",
    "polyphony": 4,
    "voice_stealing": "quietest_releasing_then_oldest"
  },
  "layers": [
    {
      "id": "drop",
      "enabled": true,
      "trigger": {
        "event": "note_on",
        "key_min": 0,
        "key_max": 127,
        "velocity_min": 1,
        "velocity_max": 127
      },
      "gain_db": -7.5,
      "pan": 0.0,
      "tuning_cents": 0.0,
      "envelope": {
        "attack_seconds": 0.0,
        "decay_seconds": 3.0,
        "sustain_level": 0.0,
        "release_seconds": 1.0
      },
      "generator": {
        "additive": {
          "phase_reset": true,
          "morph": 0.0,
          "spectrum_tilt_db_per_octave": 0.0,
          "inharmonicity": 0.0,
          "partials": [
            {
              "id": "fundamental",
              "ratio": 1.0,
              "amplitude_a": 1.0,
              "amplitude_b": 1.0,
              "phase": 0.0,
              "envelope": { "attack_seconds": 0.0, "decay_seconds": 3.0, "sustain_level": 0.0, "release_seconds": 1.0 }
            },
            {
              "id": "octave",
              "ratio": 2.0,
              "amplitude_a": 0.09,
              "amplitude_b": 0.09,
              "phase": 0.0,
              "envelope": { "attack_seconds": 0.0, "decay_seconds": 1.2, "sustain_level": 0.0, "release_seconds": 0.6 }
            }
          ]
        }
      },
      "processors": []
    }
  ],
  "voice_processors": [
    { "type": "filter", "id": "sink", "mode": "low_pass", "cutoff_hz": 6000.0, "resonance": 0.04 }
  ],
  "global_processors": [
    { "type": "limiter", "id": "cap", "ceiling_db": -1.5, "release_ms": 250.0, "input_gain_db": 0.0 }
  ],
  "modulation": {
    "sources": [
      {
        "id": "sink",
        "type": "mseg",
        "initial_value": 0.0,
        "segments": [
          { "duration": { "value": 2.6, "unit": "seconds" }, "target": -1.0, "curve": "smooth_step" }
        ]
      }
    ],
    "routes": [
      { "source": "sink", "target": "layer.drop.tuning", "depth": { "value": -1150.0, "unit": "cents" }, "curve": "linear" },
      { "source": "sink", "target": "voice.processor.sink.cutoff", "depth": { "value": -1.6, "unit": "octaves" }, "curve": "linear" },
      { "source": "velocity", "target": "layer.drop.gain", "depth": { "value": 9.0, "unit": "decibels" }, "curve": "smooth_step" },
      { "source": "mod_wheel", "target": "voice.processor.sink.cutoff", "depth": { "value": 0.8, "unit": "octaves" }, "curve": "linear" },
      { "source": "pitch_bend", "target": "layer.drop.tuning", "depth": { "value": 200.0, "unit": "cents" }, "curve": "linear" }
    ]
  },
  "macros": [],
  "vectors": []
}

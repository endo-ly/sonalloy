{
  "schema_version": 5,
  "metadata": {
    "name": "Motion Step Sequence",
    "author": "glm-5.3-flash",
    "description": "音程を保ちながら、明るさ・折り返し量・左右位置がステップごとに段階的に変わるモーション音。単純なLFOの往復ではなく複数の状態が順番に現れ、長く保持するコードや単音に継続的な展開を与える。静止したパッドとは明確に異なる、反復しても音色の展開を感じられる動きを持つ。"
  },
  "performance": {
    "mode": "polyphonic",
    "polyphony": 8,
    "voice_stealing": "quietest_releasing_then_oldest"
  },
  "layers": [
    {
      "id": "motion",
      "enabled": true,
      "trigger": {
        "event": "note_on",
        "key_min": 0,
        "key_max": 127,
        "velocity_min": 1,
        "velocity_max": 127
      },
      "gain_db": -11.5,
      "pan": 0.0,
      "tuning_cents": 0.0,
      "envelope": {
        "attack_seconds": 0.01,
        "decay_seconds": 0.0,
        "sustain_level": 1.0,
        "release_seconds": 0.6
      },
      "generator": {
        "oscillator": {
          "waveform": { "type": "saw" },
          "phase_reset": true,
          "phase": 0.0,
          "wavefold": { "amount": 0.35 }
        }
      },
      "processors": []
    }
  ],
  "voice_processors": [
    { "type": "filter", "id": "shape", "mode": "low_pass", "cutoff_hz": 2800.0, "resonance": 0.1 }
  ],
  "global_processors": [
    { "type": "limiter", "id": "cap", "ceiling_db": -1.5, "release_ms": 120.0, "input_gain_db": 0.0 }
  ],
  "modulation": {
    "sources": [
      {
        "id": "bright",
        "type": "step",
        "values": [0.9, -0.3, 0.5, -0.9, 0.2, 0.7, -0.5, -0.1],
        "rate": { "value": 1.0, "unit": "per_beat" }
      },
      {
        "id": "fold",
        "type": "step",
        "values": [-0.4, 0.6, 0.1, -0.8, 0.5, -0.2, 0.9, -0.6],
        "rate": { "value": 2.0, "unit": "per_beat" }
      },
      {
        "id": "drift_pan",
        "type": "step",
        "values": [0.7, -0.7, 0.2, -0.5, 0.6, -0.2, 0.5, -0.9],
        "rate": { "value": 0.5, "unit": "per_beat" }
      }
    ],
    "routes": [
      { "source": "bright", "target": "voice.processor.shape.cutoff", "depth": { "value": 0.9, "unit": "octaves" }, "curve": "linear" },
      { "source": "fold", "target": "layer.motion.generator.wavefold", "depth": { "value": 0.3, "unit": "normalized" }, "curve": "linear" },
      { "source": "drift_pan", "target": "layer.motion.pan", "depth": { "value": 0.6, "unit": "pan" }, "curve": "linear" },
      { "source": "velocity", "target": "layer.motion.gain", "depth": { "value": 8.0, "unit": "decibels" }, "curve": "smooth_step" },
      { "source": "mod_wheel", "target": "voice.processor.shape.cutoff", "depth": { "value": 0.6, "unit": "octaves" }, "curve": "linear" },
      { "source": "pitch_bend", "target": "layer.motion.tuning", "depth": { "value": 200.0, "unit": "cents" }, "curve": "linear" }
    ]
  },
  "macros": [],
  "vectors": []
}

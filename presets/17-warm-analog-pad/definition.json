{
  "schema_version": 5,
  "external_audio": null,
  "metadata": {
    "name": "Warm Analog Pad",
    "author": null,
    "description": "コードの背景を柔らかく支える、標準的なアナログ系パッド。Sawの軽いDetuneにTriangleの温かさを重ね、Ladder Filterで高域を穏やかに丸める。緩やかな立ち上がりと自然な余韻が長時間鳴らしても邪魔にならず、C2〜C6程度のコードでも各音の関係が分かる。派手な変化よりも安定感を優先した、汎用パッドの基準となる音。"
  },
  "performance": {
    "mode": "polyphonic",
    "polyphony": 8,
    "voice_stealing": "quietest_releasing_then_oldest"
  },
  "layers": [
    {
      "id": "warm",
      "enabled": true,
      "trigger": {
        "event": "note_on",
        "key_min": 0,
        "key_max": 127,
        "velocity_min": 1,
        "velocity_max": 127
      },
      "gain_db": -14.5,
      "pan": 0.0,
      "tuning_cents": 0.0,
      "envelope": {
        "attack_seconds": 0.5,
        "decay_seconds": 0.5,
        "sustain_level": 0.8,
        "release_seconds": 1.0
      },
      "generator": {
        "oscillator": {
          "waveform": {
            "type": "saw"
          },
          "phase_reset": true,
          "phase": 0.0,
          "unison": {
            "voices": 3,
            "detune_cents": 12.0,
            "stereo_spread": 0.5,
            "phase_spread": 0.0
          }
        }
      },
      "processors": []
    },
    {
      "id": "body",
      "enabled": true,
      "trigger": {
        "event": "note_on",
        "key_min": 0,
        "key_max": 127,
        "velocity_min": 1,
        "velocity_max": 127
      },
      "gain_db": -16.5,
      "pan": 0.0,
      "tuning_cents": 0.0,
      "envelope": {
        "attack_seconds": 0.5,
        "decay_seconds": 0.5,
        "sustain_level": 0.8,
        "release_seconds": 1.0
      },
      "generator": {
        "oscillator": {
          "waveform": {
            "type": "triangle"
          },
          "phase_reset": true,
          "phase": 0.0
        }
      },
      "processors": []
    }
  ],
  "voice_processors": [
    {
      "type": "ladder_filter",
      "id": "soften",
      "cutoff_hz": 3500.0,
      "resonance": 0.08,
      "drive": 0.1
    }
  ],
  "global_processors": [
    {
      "type": "limiter",
      "id": "cap",
      "ceiling_db": -1.5,
      "release_ms": 250.0,
      "input_gain_db": 0.0

{
  "schema_version": 5,
  "external_audio": null,
  "metadata": {
    "name": "808 Bass",
    "author": "gpt-6-astra low",
    "description": "発音直後の大きな音程下降と、その後に続く深く滑らかな低音が特徴の808系ベース。Sine基音に軽いSaturationを加え、低域中心のまま小さなスピーカーにも存在感を残す。短い音では落下感が明確に現れ、長音では下降後の音程が安定して低域を支え続ける。"
  },
  "performance": {
    "mode": "monophonic",
    "legato": false
  },
  "layers": [
    {
      "id": "body",
      "enabled": true,
      "trigger": {
        "event": "note_on",
        "key_min": 0,
        "key_max": 127,
        "velocity_min": 1,
        "velocity_max": 127
      },
      "gain_db": -11,
      "pan": 0.0,
      "tuning_cents": 0.0,
      "envelope": {
        "attack_seconds": 0.002,
        "decay_seconds": 0.4,
        "sustain_level": 0.82,
        "release_seconds": 0.12
      },
      "generator": {
        "oscillator": {
          "waveform": {
            "type": "sine"
          },
          "phase_reset": true,
          "phase": 0.0,
          "waveshaping": {
            "amount": 0.08
          }
        }
      },
      "processors": []
    }
  ],
  "voice_processors": [],
  "global_processors": [],
  "modulation": {
    "sources": [
      {
        "id": "drop",
        "type": "mseg",
        "initial_value": 1,
        "segments": [
          {
            "duration": {
              "value": 0.025,
              "unit": "seconds"
            },
            "target": 0.18,
            "curve": "smooth_step"
          },
          {
            "duration": {
              "value": 0.065,
              "unit": "seconds"
            },
            "target": 0,
            "curve": "smooth_step"
          }
        ],
        "loop_range": null
      }
    ],
    "routes": [
      {
        "source": "drop",
        "target": "layer.body.tuning",
        "depth": {
          "value": 1000,
          "unit": "cents"
        },
        "curve": "linear"
      },
      {
        "source": "velocity",
        "target": "layer.body.gain",
        "depth": {
          "value": 6.0,
          "unit": "decibels"
        },
        "curve": "linear"
      },
      {
        "source": "mod_wheel",
        "target": "layer.body.generator.waveshape",
        "depth": {
          "value": 0.12,
          "unit": "normalized"
        },
        "curve": "linear"
      },
      {
        "source": "pitch_bend",

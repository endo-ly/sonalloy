{
  "schema_version": 5,
  "external_audio": null,
  "metadata": {
    "name": "Synth Strings",
    "author": null,
    "description": "弦のアンサンブルを連想させる、滑らかで広がりのある合成コード音。16 centのDetuneを持つ5 Voice UnisonとChorusが、複数の電子音が重なった古典的なシンセストリングスらしい均一な厚みを作る。0.4秒の立ち上がりは急激すぎず、押している間は安定した厚みを保ち、離した後にも短い余韻が残る。高域は柔らかな明るさに抑え、コードの背景にも前景にも使える。"
  },
  "performance": {
    "mode": "polyphonic",
    "polyphony": 8,
    "voice_stealing": "quietest_releasing_then_oldest"
  },
  "layers": [
    {
      "id": "strings",
      "enabled": true,
      "trigger": {
        "event": "note_on",
        "key_min": 0,
        "key_max": 127,
        "velocity_min": 1,
        "velocity_max": 127
      },
      "gain_db": -11.5,
      "pan": 0.0,
      "tuning_cents": 0.0,
      "envelope": {
        "attack_seconds": 0.4,
        "decay_seconds": 0.5,
        "sustain_level": 0.85,
        "release_seconds": 0.6
      },
      "generator": {
        "oscillator": {
          "waveform": {
            "type": "saw"
          },
          "phase_reset": true,
          "phase": 0.0,
          "unison": {
            "voices": 5,
            "detune_cents": 16.0,
            "stereo_spread": 0.8,
            "phase_spread": 0.6
          }
        }
      },
      "processors": []
    }
  ],
  "voice_processors": [
    {
      "type": "filter",
      "id": "bow",
      "mode": "low_pass",
      "cutoff_hz": 4800.0,
      "resonance": 0.06
    }
  ],
  "global_processors": [
    {
      "type": "chorus",
      "id": "ensemble",
      "delay_ms": 12.0,
      "rate_hz": 0.8,
      "depth": 0.22,
      "width": 1.0,
      "mix": 0.18,
      "feedback": 0.0
    },
    {
      "type": "limiter",
      "id": "cap",
      "ceiling_db": -1.5,
      "release_ms": 250.0,
      "input_gain_db": 0.0
    }
  ],
  "modulation": {
    "sources": [],
    "routes": [
      {
        "source": "velocity",
        "target": "layer.strings.gain",
        "depth": {
          "value": 4.0,
          "unit": "decibels"
        },
        "curve": "linear"
      }
    ]
  },
  "macros": [],
  "vectors": []
}

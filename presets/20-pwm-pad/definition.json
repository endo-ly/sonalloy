{
  "schema_version": 5,
  "external_audio": null,
  "metadata": {
    "name": "PWM Pad",
    "author": null,
    "description": "長く保持すると内部の倍音が呼吸するように変化する、古典的なPWMパッド。幅の異なる2つのPulse波へ逆位相のLFOでPulse Widthを動かし、音程そのものではなく厚みと空洞感を周期的に変える。立ち上がりと余韻は長く、コードの背景として継続的に使いやすい。静止したアナログパッドより内部の動きが明確。"
  },
  "performance": {
    "mode": "polyphonic",
    "polyphony": 8,
    "voice_stealing": "quietest_releasing_then_oldest"
  },
  "layers": [
    {
      "id": "pulse_a",
      "enabled": true,
      "trigger": {
        "event": "note_on",
        "key_min": 0,
        "key_max": 127,
        "velocity_min": 1,
        "velocity_max": 127
      },
      "gain_db": -16.0,
      "pan": 0.0,
      "tuning_cents": 0.0,
      "envelope": {
        "attack_seconds": 0.7,
        "decay_seconds": 0.5,
        "sustain_level": 0.8,
        "release_seconds": 1.1
      },
      "generator": {
        "oscillator": {
          "waveform": {
            "type": "pulse",
            "pulse_width": 0.45
          },
          "phase_reset": true,
          "phase": 0.0
        }
      },
      "processors": []
    },
    {
      "id": "pulse_b",
      "enabled": true,
      "trigger": {
        "event": "note_on",
        "key_min": 0,
        "key_max": 127,
        "velocity_min": 1,
        "velocity_max": 127
      },
      "gain_db": -16.0,
      "pan": 0.0,
      "tuning_cents": 0.0,
      "envelope": {
        "attack_seconds": 0.7,
        "decay_seconds": 0.5,
        "sustain_level": 0.8,
        "release_seconds": 1.1
      },
      "generator": {
        "oscillator": {
          "waveform": {
            "type": "pulse",
            "pulse_width": 0.55
          },
          "phase_reset": true,
          "phase": 0.0
        }
      },
      "processors": []
    }
  ],
  "voice_processors": [
    {
      "type": "filter",
      "id": "smooth",
      "mode": "low_pass",
      "cutoff_hz": 5500.0,
      "resonance": 0.06
    }
  ],
  "global_processors": [
    {
      "type": "limiter",
      "id": "cap",
      "ceiling_db": -1.5,
      "release_ms": 250.0,
      "input_gain_db": 0.0
    }
  ],
  "modulation": {
    "sources": [
      {
        "id": "breath",
        "type": "lfo",
        "waveform": "sine",
        "rate": {
          "value": 0.3,
          "unit": "per_second"
        },
        "phase": 0.0
      }
    ],
    "routes": [
      {
        "source": "breath",
        "target": "layer.pulse_a.generator.pulse_width",
        "depth": {
          "value": 0.18,
          "unit": "normalized"
        },
        "curve": "linear"
      },
      {
        "source": "breath",
        "target": "layer.pulse_b.generator.pulse_width",
        "depth": {
          "value": -0.18,
          "unit": "normalized"
        },
        "curve": "linear"
      },
      {
        "source": "velocity",
        "target": "layer.pulse_a.gain",
        "depth": {
          "value": 4.0,
          "unit": "decibels"
        },
        "curve": "linear"
      },
      {
        "source": "velocity",
        "target": "layer.pulse_b.gain",
        "depth": {
          "value": 4.0,
          "unit": "decibels"
        },
        "curve": "linear"
      }
    ]
  },
  "macros": [],
  "vectors": []
}

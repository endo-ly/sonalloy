{
  "schema_version": 5,
  "external_audio": null,
  "metadata": {
    "name": "Pulse Lead",
    "author": null,
    "description": "SquareやPulse系を連想させる、細身で明快な電子リード。Pulse波の輪郭を優先し、厚みよりも各音の芯と音程の明確さを取る。C3からC7付近まで性格が変わらず、高音域でも音の芯が残る。ゲーム音楽、Electro、Synth Popの旋律に適する。"
  },
  "performance": {
    "mode": "monophonic",
    "legato": false
  },
  "layers": [
    {
      "id": "pulse",
      "enabled": true,
      "trigger": {
        "event": "note_on",
        "key_min": 0,
        "key_max": 127,
        "velocity_min": 1,
        "velocity_max": 127
      },
      "gain_db": -4.0,
      "pan": 0.0,
      "tuning_cents": 0.0,
      "envelope": {
        "attack_seconds": 0.003,
        "decay_seconds": 0.1,
        "sustain_level": 0.7,
        "release_seconds": 0.08
      },
      "generator": {
        "oscillator": {
          "waveform": {
            "type": "pulse",
            "pulse_width": 0.4
          },
          "phase_reset": true,
          "phase": 0.0
        }
      },
      "processors": []
    }
  ],
  "voice_processors": [
    {
      "type": "filter",
      "id": "tone",
      "mode": "low_pass",
      "cutoff_hz": 12000.0,
      "resonance": 0.05
    }
  ],
  "global_processors": [],
  "modulation": {
    "sources": [],
    "routes": [
      {
        "source": "velocity",
        "target": "layer.pulse.gain",
        "depth": {
          "value": 6.0,
          "unit": "decibels"
        },
        "curve": "linear"
      },
      {
        "source": "velocity",
        "target": "voice.processor.tone.cutoff",
        "depth": {
          "value": 0.4,
          "unit": "octaves"
        },
        "curve": "linear"
      }
    ]
  },
  "macros": [],
  "vectors": []
}

{
  "schema_version": 5,
  "external_audio": null,
  "metadata": {
    "name": "Tone Wheel Organ",
    "author": null,
    "description": "Hammond系オルガンを連想させる、倍音が規則的に積み重なる持続鍵盤音。ドローバーに相当する0.5〜8倍のSine Partialを加算し、単音でも複数の倍音が明確に聞こえる。鍵盤を押している間はほぼ一定の音量で鳴り続け、コードでは厚い和音を形成する。軽いChorusが回転スピーカー風のうるおいを添える素のオルガン音。"
  },
  "performance": {
    "mode": "polyphonic",
    "polyphony": 8,
    "voice_stealing": "quietest_releasing_then_oldest"
  },
  "layers": [
    {
      "id": "organ",
      "enabled": true,
      "trigger": {
        "event": "note_on",
        "key_min": 0,
        "key_max": 127,
        "velocity_min": 1,
        "velocity_max": 127
      },
      "gain_db": -12.0,
      "pan": 0.0,
      "tuning_cents": 0.0,
      "envelope": {
        "attack_seconds": 0.006,
        "decay_seconds": 0.05,
        "sustain_level": 1.0,
        "release_seconds": 0.15
      },
      "generator": {
        "additive": {
          "phase_reset": true,
          "morph": 0.0,
          "spectrum_tilt_db_per_octave": 0.0,
          "inharmonicity": 0.0,
          "partials": [
            {
              "id": "sub",
              "ratio": 0.5,
              "amplitude_a": 0.7,
              "amplitude_b": 0.7,
              "phase": 0.0
            },
            {
              "id": "fund",
              "ratio": 1.0,

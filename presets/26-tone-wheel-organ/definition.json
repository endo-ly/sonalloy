              "amplitude_b": 0.65,
              "phase": 0.0
            },
            {
              "id": "h3",
              "ratio": 3.0,
              "amplitude_a": 0.5,
              "amplitude_b": 0.5,
              "phase": 0.0
            },
            {
              "id": "h4",

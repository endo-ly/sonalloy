{
  "schema_version": 1,
  "metadata": {
    "name": "Metallic Hybrid Body",
    "author": "Sonalloy",
    "description": "The oscillator body used by Metallic Hybrid"
  },
  "performance": {
    "polyphony": 16,
    "voice_stealing": "quietest_releasing_then_oldest"
  },
  "layers": [
    {
      "id": "body",
      "enabled": true,
      "trigger": {
        "key_min": 0,
        "key_max": 127,
        "velocity_min": 1,
        "velocity_max": 127
      },
      "gain_db": -18.0,
      "pan": 0.0,
      "tuning_cents": 0.0,
      "envelope": {
        "attack_seconds": 0.004,
        "decay_seconds": 0.28,
        "sustain_level": 0.68,
        "release_seconds": 0.36
      },
      "generator": {
        "oscillator": {
          "waveform": "sine",
          "phase_reset": true
        }
      }
    }
  ],
  "voice_processors": [
    {
      "type": "filter",
      "id": "tone",
      "cutoff_hz": 8500.0,
      "resonance": 0.15
    }
  ],
  "global_processors": [],
  "modulation": {
    "sources": [],
    "routes": [
      {
        "source": "velocity",
        "target": "layer.body.gain",
        "amount": 0.06,
        "curve": "linear"
      },
      {
        "source": "velocity",
        "target": "voice.processor.tone.cutoff",
        "amount": 0.06,
        "curve": "linear"
      }
    ]
  }
}
